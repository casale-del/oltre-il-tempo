
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Oltre il tempo</title>

<script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

<style>
body { margin:0; font-family:Arial,sans-serif; background:#06132d; }
#intro {
position:fixed; inset:0; z-index:10;
display:flex; flex-direction:column;
justify-content:center; align-items:center;
text-align:center; padding:25px;
color:white; background:radial-gradient(#183b70,#06132d);
}
h1 { color:#ffd66b; letter-spacing:3px; }
button {
padding:15px 25px; border:0; border-radius:30px;
background:#ffd66b; color:#14213d;
font-size:18px; font-weight:bold;
}
#message {
position:fixed; top:15px; left:10px; right:10px;
z-index:5; color:white; text-align:center;
text-shadow:0 2px 5px black;
}
a-scene { position:fixed; inset:0; }
</style>
</head>

<body>

<div id="intro">
<h1>OLTRE IL TEMPO</h1>
<p>La stella del presepe sta per prendere vita.</p>
<p>Inquadra la stella stampata e scopri la magia.</p>
<button id="start">INIZIA L'ESPERIENZA</button>
</div>

<div id="message">Inquadra la stella sul foglio</div>

<a-scene
mindar-image="imageTargetSrc: ./targets.mind; autoStart: false; uiScanning: false; uiLoading: false;"
vr-mode-ui="enabled: false"
device-orientation-permission-ui="enabled: false"
embedded>

<a-camera position="0 0 0" look-controls="enabled: false"></a-camera>

<a-entity id="target" mindar-image-target="targetIndex: 0">

<!-- Alone dorato -->
<a-ring position="0 0 0.05"
radius-inner="0.35" radius-outer="0.43"
material="color:#ffd66b; shader:flat; opacity:0.9"
animation="property:rotation; to:0 0 360; dur:8000; loop:true">
</a-ring>

<!-- Stella centrale -->
<a-entity id="star" position="0 0 0.15"
animation__move="property:position; from:0 0 0.15; to:0 0 1; dur:1800; dir:alternate; loop:true"
animation__size="property:scale; from:0.5 0.5 0.5; to:1.3 1.3 1.3; dur:1800; dir:alternate; loop:true">

<a-sphere radius="0.13"
material="color:#fff4bd; emissive:#ffd34f; emissiveIntensity:2">
</a-sphere>

<a-box width="0.12" height="0.85" depth="0.05"
material="color:#ffd34f; emissive:#ffbd36; emissiveIntensity:1">
</a-box>

<a-box width="0.85" height="0.12" depth="0.05"
material="color:#ffd34f; emissive:#ffbd36; emissiveIntensity:1">
</a-box>

<a-box width="0.10" height="0.65" depth="0.05"
rotation="0 0 45"
material="color:#ffe28a; emissive:#ffbd36; emissiveIntensity:1">
</a-box>

<a-box width="0.10" height="0.65" depth="0.05"
rotation="0 0 -45"
material="color:#ffe28a; emissive:#ffbd36; emissiveIntensity:1">
</a-box>
</a-entity>

<!-- Scintille -->
<a-sphere position="-0.45 0.3 0.4" radius="0.035"
material="color:#fff2a8; emissive:#ffd34f"
animation="property:scale; to:2 2 2; dur:900; dir:alternate; loop:true">
</a-sphere>

<a-sphere position="0.4 0.25 0.5" radius="0.03"
material="color:#fff2a8; emissive:#ffd34f"
animation="property:scale; to:2 2 2; dur:1100; dir:alternate; loop:true">
</a-sphere>

<a-sphere position="0.35 -0.35 0.4" radius="0.03"
material="color:#fff2a8; emissive:#ffd34f"
animation="property:scale; to:2 2 2; dur:800; dir:alternate; loop:true">
</a-sphere>

</a-entity>
</a-scene>

<script>
const scene = document.querySelector("a-scene");
const intro = document.getElementById("intro");
const message = document.getElementById("message");
const target = document.getElementById("target");

document.getElementById("start").addEventListener("click", () => {
intro.style.display = "none";
message.textContent = "Avvio della fotocamera...";

scene.addEventListener("arReady", () => {
message.textContent = "Inquadra la stella stampata!";
}, {once:true});

scene.addEventListener("arError", () => {
message.textContent = "Errore fotocamera: controlla i permessi.";
}, {once:true});

target.addEventListener("targetFound", () => {
message.textContent = "La stella è apparsa! ✨";
});

target.addEventListener("targetLost", () => {
message.textContent = "Inquadra nuovamente la stella.";
});

scene.systems["mindar-image-system"].start();
});
</script>

</body>
</html>
