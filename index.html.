
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oltre il tempo – Il presepe</title>

<script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

<style>
body {
  margin: 0;
  background: #07142e;
  color: white;
  font-family: Arial, sans-serif;
}
#intro {
  position: absolute;
  z-index: 2;
  top: 12px;
  left: 0;
  right: 0;
  text-align: center;
  pointer-events: none;
}
h1 { font-size: 23px; margin: 5px; letter-spacing: 2px; }
p { font-size: 14px; }
#start {
  position: absolute;
  z-index: 5;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 17px 26px;
  border: 0;
  border-radius: 14px;
  background: #f5d36b;
  color: #17213a;
  font-size: 18px;
  font-weight: bold;
}
a-scene { width: 100vw; height: 100vh; }
</style>

<script>
AFRAME.registerComponent('star3d', {
  init: function () {
    const shape = new THREE.Shape();
    const outer = 0.48;
    const inner = 0.21;

    for (let i = 0; i < 10; i++) {
      const radius = i % 2 === 0 ? outer : inner;
      const angle = -Math.PI / 2 + i * Math.PI / 5;
      const x = Math.cos(angle) * radius;
      const y = Math.sin(angle) * radius;
      if (i === 0) shape.moveTo(x, y);
      else shape.lineTo(x, y);
    }
    shape.closePath();

    const geometry = new THREE.ExtrudeGeometry(shape, {
      depth: 0.12,
      bevelEnabled: true,
      bevelSegments: 4,
      steps: 1,
      bevelSize: 0.025,
      bevelThickness: 0.025
    });

    geometry.center();

    const white = new THREE.MeshStandardMaterial({
      color: 0xfff8df,
      emissive: 0xffe9a6,
      emissiveIntensity: 1.4,
      metalness: 0.25,
      roughness: 0.2
    });

    const gold = new THREE.MeshStandardMaterial({
      color: 0xe5a928,
      emissive: 0x9c5d08,
      emissiveIntensity: 0.8,
      metalness: 0.85,
      roughness: 0.22
    });

    const star = new THREE.Mesh(geometry, [white, gold]);
    this.el.object3D.add(star);
  }
});

AFRAME.registerComponent('soft-halo', {
  init: function () {
    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d');

    const gradient = ctx.createRadialGradient(128,128,4,128,128,128);
    gradient.addColorStop(0, 'rgba(255,255,230,0.9)');
    gradient.addColorStop(0.18, 'rgba(255,226,145,0.45)');
    gradient.addColorStop(0.48, 'rgba(255,190,75,0.16)');
    gradient.addColorStop(1, 'rgba(255,180,50,0)');

    ctx.fillStyle = gradient;
    ctx.fillRect(0,0,256,256);

    const texture = new THREE.CanvasTexture(canvas);
    const material = new THREE.MeshBasicMaterial({
      map: texture,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide
    });

    const plane = new THREE.Mesh(
      new THREE.PlaneGeometry(1.9, 1.9),
      material
    );
    plane.position.z = -0.13;
    this.el.object3D.add(plane);
  }
});

AFRAME.registerComponent('sparkle-field', {
  init: function () {
    this.particles = [];
    const group = new THREE.Group();

    for (let i = 0; i < 42; i++) {
      const size = 0.009 + Math.random() * 0.018;
      const geometry = new THREE.SphereGeometry(size, 8, 8);
      const material = new THREE.MeshBasicMaterial({
        color: i % 3 === 0 ? 0xffffff : 0xffd66b,
        transparent: true,
        opacity: 0.9
      });

      const particle = new THREE.Mesh(geometry, material);
      const angle = Math.random() * Math.PI * 2;
      const radius = 0.42 + Math.random() * 0.48;

      particle.position.set(
        Math.cos(angle) * radius,
        Math.sin(angle) * radius,
        Math.random() * 0.25
      );

      group.add(particle);
      this.particles.push({
        mesh: particle,
        phase: Math.random() * Math.PI * 2,
        speed: 1 + Math.random() * 2
      });
    }

    this.el.object3D.add(group);
  },

  tick: function (time) {
    this.particles.forEach(p => {
      const glow = 0.35 + 0.65 *
        (0.5 + 0.5 * Math.sin(time * 0.003 * p.speed + p.phase));

      p.mesh.material.opacity = glow;
      p.mesh.scale.setScalar(0.6 + glow * 0.8);
    });
  }
});
</script>
</head>

<body>
<div id="intro">
  <h1>OLTRE IL TEMPO</h1>
  <p>Inquadra la stella e scopri la sorpresa</p>
</div>

<button id="start">✨ INIZIA</button>

<a-scene
  mindar-image="imageTargetSrc: ./targets.mind; autoStart: false; uiScanning: true;"
  color-space="sRGB"
  renderer="colorManagement: true; physicallyCorrectLights: true"
  vr-mode-ui="enabled: false"
  device-orientation-permission-ui="enabled: false">

  <a-camera position="0 0 0" look-controls="enabled: false"></a-camera>

  <a-entity mindar-image-target="targetIndex: 0">

    <a-entity
      position="0 0 0.15"
      animation__rise="property: position; to: 0 0 0.65; dur: 2200; easing: easeOutCubic"
      animation__breathe="property: scale; from: 0.8 0.8 0.8; to: 1 1 1; dir: alternate; dur: 1800; loop: true">

      <a-entity soft-halo></a-entity>

      <a-entity
        star3d
        animation="property: rotation; to: 0 0 360; dur: 18000; loop: true; easing: linear">
      </a-entity>

      <a-entity sparkle-field></a-entity>

      <a-light type="point" color="#ffe4a0" intensity="1.5" distance="3"></a-light>

    </a-entity>
  </a-entity>
</a-scene>

<script>
const button = document.querySelector("#start");

button.addEventListener("click", async () => {
  button.style.display = "none";
  const scene = document.querySelector("a-scene");
  const system = scene.systems["mindar-image-system"];
  await system.start();
});
</script>
</body>
</html>
